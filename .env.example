# ==============================================================================
# Tender Corrigendum & Amendment Tracker - Environment Configuration
# ==============================================================================

# Application & Host URLs
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
PROCESSING_SERVICE_URL=http://localhost:8001
PORT=4000
WEB_PORT=3000

# Authentication & Cryptographic Security
# Generate a cryptographically secure 256-bit secret for production (e.g., openssl rand -base64 32)
AUTH_SECRET=super-secret-development-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# PostgreSQL Database Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tender_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Redis (Queues, Background Jobs, and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tender-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Email Service (SMTP / Transactional Email Provider)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test-user
SMTP_PASSWORD=test-password
EMAIL_FROM_ADDRESS=notifications@tender-tracker.local
EMAIL_FROM_NAME="Tender Tracker Alerts"

# Document Processing & Optical Character Recognition
OCR_ENGINE=tesseract
OCR_LANGUAGE_DATA=eng,guj,hin
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=application/pdf,application/zip

# Collector Agent Settings
COLLECTION_USER_AGENT="TenderTrackerAuditCollector/1.0 (+http://localhost:3000/bot-info)"
COLLECTION_RATE_LIMIT_DELAY_MS=2000
MAX_CONCURRENT_SCRAPES=3

# Optional AI / LLM Integration (Summary & Impact Analysis)
# Leave blank to run purely on deterministic rule-based analysis
AI_PROVIDER=none
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_TEMPERATURE=0.2

